{
  "name": "handys",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "setup": "node apps/server/scripts/setup-dev.js",
    "dev": "concurrently -k -n server,web -c blue,green \"npm run start:dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "test": "npm test -w apps/server && npm test -w apps/web",
    "test:int": "npm run test:int -w apps/server",
    "e2e": "npm run build && npm test -w e2e",
    "start": "npm run start:prod -w apps/server",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "screenshots": "node e2e/screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.0"
  }
}
