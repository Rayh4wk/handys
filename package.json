{
  "name": "handys",
  "private": true,
  "workspaces": [
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "test": "npm test -w apps/server && npm test -w apps/web",
    "test:int": "npm run test:int -w apps/server",
    "e2e": "npm run build && npm test -w e2e",
    "start": "npm run start:prod -w apps/server",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.0"
  }
}
