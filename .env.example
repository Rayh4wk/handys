# Copy to apps/server/.env for local development:  cp .env.example apps/server/.env
# Replace USER with your local PostgreSQL user.
DATABASE_URL="postgresql://USER@localhost:5432/handys"

# Session cookie signing key. Any non-empty string for local use.
SESSION_SECRET="dev-only-session-secret"

# `npm run dev` ports: API (PORT, default 3300) and Vite (WEB_PORT, default 5300).
# PORT=3300
# WEB_PORT=5300

# Integration tests / e2e use their own databases (defaults shown; created automatically).
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/handys_test"
# E2E_DATABASE_URL="postgresql://USER@localhost:5432/handys_e2e"
